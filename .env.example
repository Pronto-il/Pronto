# Pronto — local development environment (example)
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
# LOCAL DEVELOPMENT NEEDS NONE OF THIS. Every value below is already the default in
# `backend/src/main/resources/application.yml`; a fresh clone runs with `docker compose up -d`
# followed by `mvn spring-boot:run` and no environment at all. This file exists to show the shape
# of the variables, and to be the thing a deployment starts from — see `.env.production.example`
# for what Production additionally requires.
#
# Every value here is a placeholder. No real credential belongs in any committed file.

# ---- environment ----------------------------------------------------------------------------
# local | test | demo | anything-else (anything else is treated as PRODUCTION and every startup
# guard applies). See common/config/ProntoEnvironment.java.
PRONTO_ENVIRONMENT=local

# ---- database (matches docker-compose.yml, variable for variable) ----------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pronto
DB_USER=pronto
DB_PASSWORD=pronto

# ---- secrets --------------------------------------------------------------------------------
# Left unset locally: application.yml's loudly-labelled placeholders apply and the guards permit
# them in `local` only. Generate with e.g. `openssl rand -base64 48`.
# JWT_SECRET=
# OTP_PEPPER=
# STORAGE_LOCAL_HMAC_SECRET=

# ---- login second factor ---------------------------------------------------------------------
# Must login present a one-time password on top of the password itself?
#
#   true   (the default if this is unset) POST /api/auth/login answers LOGIN_OTP with a challenge
#          and the session is minted only once the code is redeemed.
#   false  TEMPORARY, pre-user stage. Login answers AUTHENTICATED with the same session a redeemed
#          code would have produced. No challenge row, no code, no SES or SNS call on the login
#          path -- which is the point while AWS SMS is sandboxed with an exhausted spend quota.
#
# It does NOT relax anything else: password verification, account lockout, login rate limiting, JWT
# validation, role authorization and every route guard are unchanged, and an account that never
# verified its email address still gets a VERIFY_EMAIL challenge rather than a session. Registration
# is entirely unaffected. Accepts exactly true or false; anything else refuses to start. The active
# mode is logged at boot as "Authentication OTP requirement: ENABLED|DISABLED".
AUTH_OTP_REQUIRED=false

# ---- providers (all default to the offline/development transport) ----------------------------
AI_MODE=mock
EMAIL_MODE=log
SMS_MODE=log
MAPS_MODE=fake
STORAGE_MODE=local

# OPENAI_API_KEY=
# MAPS_API_KEY=

# ---- browser / proxy ------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
BEHIND_PROXY=false
# TRUSTED_PROXIES=

# ---- frontend (Vite) ------------------------------------------------------------------------
# ANYTHING PREFIXED VITE_ IS COMPILED INTO THE BUNDLE AND IS PUBLIC. Never put a secret here.
VITE_API_BASE_URL=http://localhost:8080

# Google Maps BROWSER key, for address autocomplete. A SEPARATE key from MAPS_API_KEY above --
# that one is the backend's and must never reach a bundle. This one is public by design; what
# makes it safe is the restriction, not the secrecy:
#   * Application restriction: HTTP referrers
#       https://prontohomeservice.com/*  and  https://www.prontohomeservice.com/*
#       (add http://localhost:5173/* for local development)
#   * API restriction: Places API (New) only
# Leaving it unset locally is fine -- the address field says search is unavailable. A PRODUCTION
# build refuses to complete without it (frontend/vite.config.ts), because a bundle without it
# renders an autocomplete that never returns a suggestion, which silently blocks every
# registration and every new booking address.
VITE_GOOGLE_MAPS_BROWSER_KEY=

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.pronto</groupId>
    <artifactId>pronto-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>pronto-backend</name>
    <description>Pronto backend REST API (Spring Boot, modular monolith)</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.28.20</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 BOM, for storage.client.S3StorageClient (pronto.storage.mode=s3),
                 per docs/architecture/api-contract-issues.md §3.2. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- STOMP-over-WebSocket realtime delivery for Pronto SOS (realtime.config.WebSocketConfig).
             The one new dependency this phase needs: it brings spring-websocket plus
             spring-messaging, which supply the in-memory simple broker and SimpMessagingTemplate.
             No external broker (Rabbit/ActiveMQ) is introduced; the simple broker is in-JVM and
             matches this codebase's single-instance, zero-external-dependency posture. See
             src/main/java/com/pronto/realtime/README.md for the scaling caveat that implies.

             Deliberately NOT adding spring-security-messaging/@EnableWebSocketSecurity: the whole
             authorization surface here is one CONNECT check plus one allow-listed SUBSCRIBE
             destination, which realtime.security.StompAuthChannelInterceptor expresses directly
             and reviewably in about 30 lines. A second security DSL for that would be more
             machinery, not more safety. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- JWT issuance/validation, per docs/architecture/api-contract.md §3.1. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- storage.client.S3StorageClient (pronto.storage.mode=s3), per
             docs/architecture/api-contract-issues.md §3.2. Version managed by the AWS SDK
             BOM above. Also provides S3Presigner/GetObjectPresignRequest (backend MS9,
             docs/architecture/backend-ms9-presigned-image-urls-design.md §5): a separate
             "software.amazon.awssdk:s3-presigner" coordinate does NOT exist on Maven Central
             (verified); S3Presigner ships inside this "s3" artifact itself, under the
             software.amazon.awssdk.services.s3.presigner package. The design doc's §5
             instruction to add a separate s3-presigner dependency was factually incorrect,
             flagged rather than silently followed. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- Production MS1: real transactional email (auth.email.SesEmailSender, pronto.email.mode=ses).
             SES v2 rather than the v1 "ses" coordinate: v1 is on AWS's own maintenance track and its
             SendEmail shape is the legacy one. Version managed by the AWS SDK BOM above. The
             DefaultCredentialsProvider chain (env -> profile -> container -> IMDS/IAM role) does ship
             inside the core client, which is what Production needs, but see the sso/ssooidc pair
             below for the one leg of that chain it does NOT ship. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sesv2</artifactId>
        </dependency>

        <!-- Local development against a real AWS account, nothing else.
             ~/.aws/config here is an IAM Identity Center (SSO) profile: `sso_session` plus a role
             name, no access keys anywhere on disk, and the AWS SDK for Java v2 does NOT bundle SSO
             credential resolution in the core client the way it bundles the env/container/IMDS legs.
             Without these two artifacts ProfileCredentialsProvider refuses the profile outright with
             "To use Sso related properties in the 'pronto-admin' profile, the 'sso' service module
             must be on the class path.", the whole chain then reports itself exhausted, and every
             SES/SNS call dies as a bare SdkClientException. That is exactly the failure this pair
             fixes; it is not speculative hardening.

             Two consequences worth stating, because both are easy to get wrong later:

             1. This changes NOTHING in Production. ECS resolves credentials at the container leg of
                the same chain, from the task IAM role, and never reaches ProfileCredentialsProvider
                at all; there is no ~/.aws/config in the image. These jars are inert there.
             2. `runtime` scope on purpose. The SDK loads both reflectively from
                ProfileCredentialsProvider; no Pronto code imports SsoClient or SsoOidcClient, and
                keeping them off the compile classpath means none accidentally starts to. ssooidc is
                required alongside sso, not optional: sso exchanges the cached token for role
                credentials, ssooidc is what refreshes that token.

             The SSO token itself still comes from `aws sso login` (profile pronto-admin) writing
             ~/.aws/sso/cache; the SDK reads that cache but cannot create it. An expired session
             surfaces as a credentials failure again, and the fix is another `aws sso login`, never
             a static key pair. Version managed by the AWS SDK BOM above. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sso</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssooidc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Production MS1: real SMS OTP delivery (auth.sms.AwsSmsSender, pronto.sms.mode=aws).
             Amazon SNS is the publish surface of AWS End User Messaging SMS: SNS::Publish with a
             PhoneNumber (rather than a TopicArn) is what actually sends the message, while the
             origination identity / sender ID / registration it uses are account-level End User
             Messaging configuration, not a different API. That is why there is no separate
             "pinpoint-sms-voice" dependency here: adding one would introduce a second SDK client
             for the same delivery path. Version managed by the AWS SDK BOM above. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>

        <!-- Production MS1: canonical E.164 phone identity (auth.service.PhoneNumberNormalizer).
             Google's libphonenumber, the same library Android's dialer uses. Deliberately a real
             library rather than a hand-rolled regex: "is 05X-XXXXXXX a valid Israeli mobile" is a
             question about a numbering plan that changes (new mobile prefixes are allocated), and a
             regex frozen in this repository would silently start rejecting legitimate customers.
             It also gives us the 0/+972/00972 equivalence for free, which is the actual MS1
             requirement: three input spellings, one stored identity. -->
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>8.13.50</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

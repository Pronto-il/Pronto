# Pronto — Production environment (example)
#
# THIS FILE IS AN EXAMPLE. Every value is a placeholder on a reserved example domain or an
# obviously-fake string. Nothing here is a real credential, and no real credential may ever be
# committed to this repository — in Production these are injected by the deployment (AWS Secrets
# Manager / SSM Parameter Store via the task definition), never from a file in source control.
#
# The application REFUSES TO START if any of the required variables below is missing or unsafe.
# Each refusal names the offending property and its environment variable, and prints no value.
# See docs/production-roadmap/reports/prod-MS4-report.md for the guard-by-guard rationale.

# ==============================================================================================
# REQUIRED — the application will not start without these
# ==============================================================================================

# ---- environment ----------------------------------------------------------------------------
# Any value other than local/test/demo enables every production guard. A typo is safe: it is
# treated as production, never as an exemption.
PRONTO_ENVIRONMENT=production

# ---- database ---------------------------------------------------------------------------------
DB_HOST=pronto.example-rds.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pronto
DB_USER=pronto_app
DB_PASSWORD=__from_secrets_manager__
# Appended verbatim to the JDBC URL. Empty by default so local development is untouched; Production
# MS5 sets it to require TLS. This is one half of a pair -- the RDS parameter group sets
# rds.force_ssl=1 so the SERVER refuses plaintext, and this makes the CLIENT refuse to silently fall
# back to it. Either half alone permits a silent downgrade.
#
# `require`, not `verify-full`: RDS presents an Amazon-issued certificate the JVM's default trust
# store does not contain, so verify-full additionally needs the RDS CA bundle in the image and an
# sslrootcert= pointing at it. Recorded as post-1.0 hardening in the deployment runbook.
DB_URL_PARAMS=?sslmode=require

# ---- secrets (three DIFFERENT values, >= 32 characters each) ----------------------------------
# Deliberately not one shared secret: they have different blast radii and rotating one must not
# force rotating the others. Generate with `openssl rand -base64 48`.
JWT_SECRET=__from_secrets_manager__
OTP_PEPPER=__from_secrets_manager__

# ---- AI ---------------------------------------------------------------------------------------
AI_MODE=openai
OPENAI_API_KEY=__from_secrets_manager__
OPENAI_MODEL=gpt-4o-mini

# ---- email (Amazon SES v2) --------------------------------------------------------------------
EMAIL_MODE=ses
EMAIL_FROM=noreply@pronto.example
EMAIL_SES_REGION=us-east-1

# ---- SMS (AWS End User Messaging) -------------------------------------------------------------
SMS_MODE=aws
AWS_SMS_REGION=us-east-1

# ---- login second factor ----------------------------------------------------------------------
# Left at the secure default here ON PURPOSE. Production keeps the OTP step unless somebody
# deliberately decides otherwise, and this file is the template a real deployment copies -- a
# commented-out "false" is exactly the kind of line that gets uncommented by accident.
#
# To run Production without the login second factor (currently under discussion while AWS End User
# Messaging is sandboxed and the monthly SMS spend quota is exhausted), add
#   { name = "AUTH_OTP_REQUIRED", value = "false" }
# to the container environment block in infra/terraform/compute.tf, next to SMS_MODE. Note that
# EMAIL_LOGIN_OTP still works today -- SES delivery is healthy -- so only phone-identifier logins
# are actually blocked by the SMS outage.
# AUTH_OTP_REQUIRED=true

# ---- maps (Google Maps Platform: Geocoding API + Routes API) ----------------------------------
MAPS_MODE=google
MAPS_API_KEY=__from_secrets_manager__

# ---- storage (S3) -----------------------------------------------------------------------------
STORAGE_MODE=s3
STORAGE_S3_BUCKET=pronto-production-uploads
STORAGE_S3_REGION=us-east-1

# ---- browser origins --------------------------------------------------------------------------
# Comma-separated. HTTPS only; no wildcard; no localhost.
CORS_ALLOWED_ORIGINS=https://app.pronto.example

# ---- proxy / client IP ------------------------------------------------------------------------
# TRUSTED_PROXIES must be the PRIVATE VPC SUBNET CIDRs the load balancer's network interfaces live
# in — never its DNS name, never AWS's published public ranges, and never 0.0.0.0/0. A publicly
# reachable range here makes every client a trusted proxy, which disables auth rate limiting
# entirely and lets any caller spend another user's bucket by naming their address. Startup
# refuses any block that is not inside private address space.
#
# THE VALUE BELOW IS AN EXAMPLE. The real subnet CIDRs do not exist yet — they are created by MS5
# (AWS Staging & Deployment Infrastructure) and must be read from the VPC, not guessed.
BEHIND_PROXY=true
TRUSTED_PROXIES=10.0.0.0/16

# ---- frontend (Vite, build time) ---------------------------------------------------------------
# ANYTHING PREFIXED VITE_ IS COMPILED INTO THE BUNDLE AND IS PUBLIC. Never put a secret here.
# `npm run build` fails if this is unset, non-HTTPS, or a development host.
VITE_API_BASE_URL=https://api.pronto.example

# ==============================================================================================
# INTENTIONALLY OPTIONAL — sensible defaults, set only to override
# ==============================================================================================
# AWS_SMS_SENDER_ID=            # empty lets AWS pick an origination identity, which is correct in
#                                 countries that ignore or forbid alphanumeric sender IDs
# SERVER_PORT=8080
# JWT_EXPIRATION_SECONDS=86400
# STORAGE_PRESIGNED_URL_TTL_SECONDS=300
# MAPS_REGION=il
# MAPS_LANGUAGE=he
# MAPS_TIMEOUT_MS=4000
# EMAIL_TIMEOUT_MS=10000
# SMS_TIMEOUT_MS=10000
# OPENAI_TIMEOUT_MS=10000
# PHONE_DEFAULT_REGION=IL
# AI_RECORD_FINAL_CLASSIFICATION=false
# ...plus every pronto.sos.*, pronto.location.* and pronto.ai.routing.* tuning value — see
#    application.yml, which documents each one.

# ==============================================================================================
# MUST NOT BE SET IN PRODUCTION
# ==============================================================================================
# DEMO_DATA_MODE                # anything but `off` refuses to start outside local/test/demo
# STORAGE_LOCAL_HMAC_SECRET     # only meaningful with STORAGE_MODE=local, which production forbids
# AWS_ACCESS_KEY_ID             # use an IAM task role, not long-lived static keys — see the MS4
# AWS_SECRET_ACCESS_KEY         # report's AWS credential recommendation

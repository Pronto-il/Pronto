<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.pronto</groupId>
    <artifactId>pronto-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>pronto-backend</name>
    <description>Pronto backend REST API (Spring Boot, modular monolith)</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.28.20</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 BOM, for storage.client.S3StorageClient (pronto.storage.mode=s3),
                 per docs/architecture/api-contract-issues.md §3.2. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- STOMP-over-WebSocket realtime delivery for Pronto SOS (realtime.config.WebSocketConfig).
             The one new dependency this phase needs: it brings spring-websocket plus
             spring-messaging, which supply the in-memory simple broker and SimpMessagingTemplate.
             No external broker (Rabbit/ActiveMQ) is introduced; the simple broker is in-JVM and
             matches this codebase's single-instance, zero-external-dependency posture. See
             src/main/java/com/pronto/realtime/README.md for the scaling caveat that implies.

             Deliberately NOT adding spring-security-messaging/@EnableWebSocketSecurity: the whole
             authorization surface here is one CONNECT check plus one allow-listed SUBSCRIBE
             destination, which realtime.security.StompAuthChannelInterceptor expresses directly
             and reviewably in about 30 lines. A second security DSL for that would be more
             machinery, not more safety. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- JWT issuance/validation, per docs/architecture/api-contract.md §3.1. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- storage.client.S3StorageClient (pronto.storage.mode=s3), per
             docs/architecture/api-contract-issues.md §3.2. Version managed by the AWS SDK
             BOM above. Also provides S3Presigner/GetObjectPresignRequest (backend MS9,
             docs/architecture/backend-ms9-presigned-image-urls-design.md §5): a separate
             "software.amazon.awssdk:s3-presigner" coordinate does NOT exist on Maven Central
             (verified); S3Presigner ships inside this "s3" artifact itself, under the
             software.amazon.awssdk.services.s3.presigner package. The design doc's §5
             instruction to add a separate s3-presigner dependency was factually incorrect,
             flagged rather than silently followed. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>

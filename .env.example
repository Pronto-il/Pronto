# Pronto — local development environment (example)
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
# LOCAL DEVELOPMENT NEEDS NONE OF THIS. Every value below is already the default in
# `backend/src/main/resources/application.yml`; a fresh clone runs with `docker compose up -d`
# followed by `mvn spring-boot:run` and no environment at all. This file exists to show the shape
# of the variables, and to be the thing a deployment starts from — see `.env.production.example`
# for what Production additionally requires.
#
# Every value here is a placeholder. No real credential belongs in any committed file.

# ---- environment ----------------------------------------------------------------------------
# local | test | demo | anything-else (anything else is treated as PRODUCTION and every startup
# guard applies). See common/config/ProntoEnvironment.java.
PRONTO_ENVIRONMENT=local

# ---- database (matches docker-compose.yml, variable for variable) ----------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pronto
DB_USER=pronto
DB_PASSWORD=pronto

# ---- secrets --------------------------------------------------------------------------------
# Left unset locally: application.yml's loudly-labelled placeholders apply and the guards permit
# them in `local` only. Generate with e.g. `openssl rand -base64 48`.
# JWT_SECRET=
# OTP_PEPPER=
# STORAGE_LOCAL_HMAC_SECRET=

# ---- providers (all default to the offline/development transport) ----------------------------
AI_MODE=mock
EMAIL_MODE=log
SMS_MODE=log
MAPS_MODE=fake
STORAGE_MODE=local

# OPENAI_API_KEY=
# MAPS_API_KEY=

# ---- browser / proxy ------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
BEHIND_PROXY=false
# TRUSTED_PROXIES=

# ---- frontend (Vite) ------------------------------------------------------------------------
# ANYTHING PREFIXED VITE_ IS COMPILED INTO THE BUNDLE AND IS PUBLIC. Never put a secret here.
VITE_API_BASE_URL=http://localhost:8080
